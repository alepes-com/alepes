{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@alepes/money": ["./packages/money/src/index.ts"],
      "@alepes/domain": ["./packages/domain/src/index.ts"],
      "@alepes/allocation-engine": ["./packages/allocation-engine/src/index.ts"],
      "@alepes/rules-engine": ["./packages/rules-engine/src/index.ts"],
      "@alepes/execution-policy": ["./packages/execution-policy/src/index.ts"],
      "@alepes/integration-runtime": ["./packages/integration-runtime/src/index.ts"],
      "@alepes/mock-bank": ["./packages/integrations/mock-bank/src/index.ts"],
      "@alepes/mock-brokerage": ["./packages/integrations/mock-brokerage/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
